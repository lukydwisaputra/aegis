# aegis/secrets/.gitignore
# Defense-in-depth: even if someone wipes the parent .gitignore, this nested
# one keeps secrets out of git.

# Ignore everything by default
*

# But allow these explicit exceptions:
!.gitignore
!README.md
!*.example
!*.example.*

# Subdirectories
oauth/*
!oauth/.gitkeep
!oauth/*.example
!oauth/*.example.*
