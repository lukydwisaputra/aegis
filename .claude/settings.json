{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|Agent|Task",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-writes.mjs\"", "timeout": 10 }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [],
    "deny": []
  }
}
