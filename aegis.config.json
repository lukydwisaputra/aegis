{
  "targetProjectRoot": "..",
  "testsDir": "../tests",
  "unitTestStyle": "auto",
  "sourceDirs": ["../apps", "../packages", "../services", "../src"],
  "shareKnowledge": false,
  "shareBooks": false,
  "stack": "auto-detect",
  "packageManager": "auto-detect",
  "emailAdapter": "mailpit",
  "profile": "full",
  "compliance": ["iso25010", "iso5055", "istqb", "cmmi", "gdpr", "pdpa"],
  "parallelism": { "maxSpecialists": 4 },
  "gates": { "planApproval": true, "defectTriage": true, "closure": true },
  "target": {
    "platform": "generic",
    "apps": []
  },
  "environments": {
    "development": {
      "url": "http://localhost:5173",
      "mode": "interactive",
      "mutating": true,
      "allowedSpecialists": ["*"],
      "purpose": "TDD loop; ambient unit + smoke; pre-commit hooks; feature-branch validation"
    },
    "testing": {
      "url": "${TESTING_PREVIEW_URL}",
      "mode": "automated",
      "mutating": true,
      "ephemeral": true,
      "ephemeralProvisioning": {
        "type": "vercel-preview",
        "dbSnapshotFrom": "staging",
        "mailpitPerInstance": true
      },
      "allowedSpecialists": ["unit", "api", "ui", "security", "a11y", "email"],
      "purpose": "PR gate; /qa-smoke 10-min budget; isolated per PR"
    },
    "staging": {
      "url": "https://stg.example.com",
      "mode": "automated",
      "mutating": true,
      "allowedSpecialists": ["*"],
      "purpose": "Full cycle on main-branch merges; nightly regression; final pre-production validation"
    },
    "production": {
      "url": "https://example.com",
      "mode": "smoke-only",
      "mutating": false,
      "readOnly": true,
      "branch": "main",
      "allowedSpecialists": ["ui", "api", "security", "a11y"],
      "forbiddenSpecialists": ["email", "performance", "unit"],
      "purpose": "Read-only synthetic monitoring; critical-path smoke"
    }
  },
  "ports": {
    "dashboard": 3030,
    "dashboardApi": 3031,
    "mailpit": { "smtp": 1025, "http": 8025 },
    "storybook": 6006,
    "k6Dashboard": 5665,
    "playwrightUI": 9323,
    "trace": 9322
  },
  "artifacts": {
    "mode": "always",
    "format": "screenshot",
    "videoTranscodeMp4": false,
    "videoQuality": "medium",
    "screenshotOnEveryStep": false,
    "retention": {
      "onSuccess": "replace-latest",
      "onFailure": "preserve-history",
      "historicalLimit": 5,
      "maxAgeRunsKept": 30
    }
  },
  "testing": {
    "automationPolicy": "stable-auto",
    "manualBudgetPercent": 10,
    "manualJustificationRequired": true,
    "manualCategoriesAllowed": [
      "visual-judgment",
      "exploratory-charter",
      "accessibility-real-AT",
      "usability-real-users"
    ]
  },
  "discovery": {
    "enabled": true,
    "entryPoints": ["/", "/login", "/dashboard"],
    "maxDepth": 5,
    "maxPagesPerRun": 100,
    "rolesToExplore": ["admin", "user"],
    "captureScreenshots": true,
    "skipPatterns": [],
    "destructiveActionHeuristics": true
  },
  "dashboard": {
    "projectName": "My Project",
    "showFrameworkBranding": false,
    "footerText": "Generated by automated QA pipeline"
  },
  "budgets": {
    "ingest": {
      "maxCostUsdPerBook": 5,
      "warnAtUsd": 3,
      "allowOpusAudit": true,
      "allowMidBookCacheRefresh": true
    },
    "validation": {
      "maxCostUsd": 30,
      "warnAtUsd": 20,
      "allowOpusForAudit": true,
      "auditRowCountCap": 80
    }
  },
  "browsers": ["chromium", "firefox", "webkit"]
}
